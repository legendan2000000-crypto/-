# KYSS 연계용 환경변수 — 실제 값은 .env 에 채우고 절대 커밋하지 말 것
# (실제 .env 는 .gitignore 로 제외됨. Cloud Functions 배포 시엔 Secret Manager 사용)
#
# 사용처: KYSS 세션 로그인 중계 (POST https://www.kyss.co.kr/api/login → 쿠키 획득)
#   인증 방식: 세션 쿠키 기반. /api/login 성공 후 세션 쿠키로 이후 조회 API 호출.
#   자세한 흐름은 kyss-api/CONTEXT 연계 섹션 및 kyss-api/README.md 참조.

# KYSS 로그인 계정
KYSS_BASE_URL=https://www.kyss.co.kr
KYSS_USERNAME=
KYSS_PASSWORD=

# (선택) Claude API 중계용 — 파싱/OCR 단계에서 사용
ANTHROPIC_API_KEY=
