# ── 둘 중 하나만 채우면 됩니다 ──────────────────────

# [무료] Google Gemini — 신용카드 불필요
#   https://aistudio.google.com/apikey 에서 발급 (구글 계정만 있으면 됨)
GEMINI_API_KEY=여기에_붙여넣기

# [유료] 나중에 회사가 승인하면 이걸 채우세요. 그러면 자동으로 이쪽을 씁니다.
# ANTHROPIC_API_KEY=sk-ant-...

# ── 필수 ────────────────────────────────────────
# 관리자 암호 (직원에게 알려주지 마세요)
ADMIN_PASSWORD=원하는암호

# ── 선택 ────────────────────────────────────────
# strict : 인사·급여·자가풀기·반입전송 코드를 AI에 안 보냄 (기본값, 권장)
# full   : 전부 AI에 보냄  ← 유료 키를 쓸 때만 권장
AI_PRIVACY=strict

# GEMINI_MODEL=gemini-2.5-flash-lite
# CLAUDE_MODEL=claude-haiku-4-5-20251001
